# Token budget: max tokens (input + output) in flight across ALL requests, and per request.
# A single request's input may use at most 2/3 of it.
LLM_CONTEXT_WINDOW=30000
LLM_MAX_INPUT_RATIO=0.6666667
# Output tokens reserved when a request doesn't set max_tokens
LLM_DEFAULT_MAX_OUTPUT_TOKENS=1000
# HTTP requests wait this long for free budget (RabbitMQ requests wait in the queue)
LLM_BUDGET_WAIT_TIMEOUT_S=60

# SGLang servers expose an OpenAI-compatible API; one server per model.
# JSON map of model name -> SGLang base URL.
LLM_MODEL_ENDPOINTS={"Qwen/Qwen3-14B": "http://localhost:30000"}
LLM_DEFAULT_MODEL=Qwen/Qwen3-14B

# RabbitMQ
LLM_RABBITMQ_ENABLED=true
LLM_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
LLM_RABBITMQ_REQUEST_QUEUE=llm.requests
LLM_RABBITMQ_RESULT_QUEUE=llm.results
